# Required: absolute path to your Obsidian-compatible Markdown vault.
OBSIDIAN_VAULT_ROOT=/path/to/your/markdown-vault

# Server binding. Keep localhost for safety; use 0.0.0.0 only on a trusted LAN.
HOST=127.0.0.1
PORT=4177

# Optional local LLM providers.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# DEEPSEEK_API_KEY=

# Optional script used by the knowledge Q&A feature.
# KB_SEARCH_SCRIPT=/path/to/your/markdown-vault/scripts/kb-search.py
